% ---------------------------------------------------------------------
% Wave mechanics
% ---------------------------------------------------------------------

% Classical relation at a wave front in a rod, extension = -(particle
% velocity)/(wave speed), i.e. tension = Z V with Z = EA/c = mu c. Read in
% the Internet Archive copy (item treatiseonmathem00loveuoft, University of
% Toronto): Chapter XX, Art. 284 "Longitudinal impact of rods", p. 418,
% which refers back to Art. 205; Art. 281 (rod struck longitudinally) uses
% the same wave picture. Cited in Section 5.3 for the wave law.
@book{love1906,
  author    = {Love, Augustus Edward Hough},
  title     = {A Treatise on the Mathematical Theory of Elasticity},
  edition   = {2nd},
  publisher = {Cambridge University Press},
  address   = {Cambridge},
  year      = {1906}
}


